# Copy this file to .env and fill in the values. Never commit .env.

# Core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Default display timezone (any IANA name). Datetimes are always stored in UTC;
# this only sets how the API renders them and how naive input is interpreted.
TIME_ZONE=Asia/Kolkata

# Database — MySQL by default. To switch to PostgreSQL, change DB_ENGINE to
# django.db.backends.postgresql and DB_PORT to 5432 (psycopg is in requirements).
# The app is DB-agnostic; no code changes are needed to switch.
DB_ENGINE=django.db.backends.mysql
DB_NAME=jigayasa
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS (comma-separated origins for the web/mobile frontend).
# Note: *.jigyaasaa.com is already allowed via CORS_ALLOWED_ORIGIN_REGEXES.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public URL of the student web app (Razorpay checkout branding + redirect).
FRONTEND_URL=http://localhost:3000

# JWT lifetimes (minutes / days)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Auth providers (pluggable; mock by default in dev)
SMS_PROVIDER=accounts.providers.ConsoleSMSProvider

# Razorpay. Leave RAZORPAY_KEY_ID empty to disable the gateway — checkout then
# falls back to the mock confirmation (POST /orders/{id}/pay/), dev/test only.
# RAZORPAY_WEBHOOK_SECRET comes from Razorpay → Settings → Webhooks and is a
# different value from the API secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CHECKOUT_NAME=Jigyaasaa
RAZORPAY_CHECKOUT_LOGO=

# Object storage (S3 / S3-compatible) for media, thumbnails & videos.
# Leave AWS_STORAGE_BUCKET_NAME empty to disable the /api/v1/uploads/ endpoints.
# For Cloudflare R2 / MinIO / DigitalOcean Spaces, set AWS_S3_ENDPOINT_URL.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ADDRESSING_STYLE=virtual
AWS_S3_UPLOAD_EXPIRY=900
AWS_S3_DOWNLOAD_EXPIRY=3600
AWS_S3_MAX_UPLOAD_BYTES=1073741824

# --- Social publishing (trainer course promotion) ---------------------------
# Leave a client id/secret pair blank to disable that network; its card then
# renders "not configured" and the connect endpoint returns 503.

# LinkedIn developer app: needs the "Sign In with LinkedIn using OpenID Connect"
# and "Share on LinkedIn" products. w_member_social is review-gated.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# One Meta app covers BOTH Facebook Pages and Instagram Business accounts.
# Needs Business Verification + App Review for pages_manage_posts and
# instagram_content_publish before it works for anyone outside the app's testers.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# Public base URL the networks redirect back to (no trailing slash), e.g.
# https://api.jigyaasaa.com — must match the redirect URI registered in each
# platform console exactly. Blank uses the incoming request host (dev only).
SOCIAL_OAUTH_REDIRECT_BASE=

# Encrypts stored OAuth tokens at rest. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this makes every stored token undecryptable — all trainers must reconnect.
SOCIAL_TOKEN_KEY=

# LinkedIn pins an API version by month (their REST API rejects calls without
# it). Move forward deliberately, roughly yearly.
LINKEDIN_API_VERSION=202405

# Path of the public course page a promoted post links to, joined to the ORIGIN
# of FRONTEND_URL. {slug} is substituted. Get this wrong and every click on
# every post you publish lands on a 404.
SOCIAL_COURSE_URL_PATH=/courses/{slug}

# How long a trainer's earning must age before a payout run can sweep it up.
# Covers the refund window, so a reversal lands on money that has not left yet.
TRAINER_PAYOUT_HOLD_DAYS=7

# --- Live sessions: Jitsi ---------------------------------------------------
# Dedicated bridge for live classes. Leave JITSI_APP_SECRET EMPTY to disable
# the integration; /live-sessions/{id}/join/ then returns the stored join_url
# unchanged. The secret must byte-match app_secret in the bridge's Prosody
# vhost (/etc/prosody/conf.d/<domain>.cfg.lua) — read it from that host, and
# never commit it.
JITSI_DOMAIN=meet.jigaysa.com
JITSI_APP_ID=jigyasa
JITSI_APP_SECRET=
JITSI_TOKEN_TTL_MINUTES=240
